jQuery(document).ready(function() {
    jQuery(document).on('click', '.subscribe-form .send-email', function(){
        function isValidEmailAddress(emailAddress) {
            var pattern = new RegExp(/^(("[\w-\s]+")|([\w-]+(?:\.[\w-]+)*)|("[\w-\s]+")([\w-]+(?:\.[\w-]+)*))(@((?:[\w-]+\.)*\w[\w-]{0,66})\.([a-z]{2,6}(?:\.[a-z]{2})?)$)|(@\[?((25[0-5]\.|2[0-4][0-9]\.|1[0-9]{2}\.|[0-9]{1,2}\.))((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[0-9]{1,2})\.){2}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[0-9]{1,2})\]?$)/i);
            return pattern.test(emailAddress);
        }
        var email = jQuery('.subscribe-form .input-email').val();
            console.log('weewe');
        if( email != 0 ){
            if( isValidEmailAddress(email) ){
                jQuery(this).parent().parent().find('.success').css('display', 'block');
                jQuery('.bg-info').css('display', 'block');
                var data = {
                    'action': 'edward_subscribe_email',
                    'user_email': email,
                };
                jQuery.ajax({
                    type: "post",
                    url: object_url.url,
                    data: data,
                    cache: false,
                    success: function(data) {

                    }
                }); 
            } else{
                jQuery(this).parent().parent().find('.error').css('display', 'block');
                jQuery('.bg-info').css('display', 'block');
            }
        } else{
                jQuery(this).parent().parent().find('.error').css('display', 'block');
                jQuery('.bg-info').css('display', 'block');
        }
        return false;
    });


});